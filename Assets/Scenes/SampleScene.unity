  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "~~~ CONTROLS ~~~\n\nLeft Mouse Button (LMB)\nSelects a unit.\nDrag to
    select multiple units.\n\nRight Mouse Button (RMB)\nMove or attack.\nEnemy units
    attack automatically.\nTo attack, you must right-click each enemy individually.\n\n\n\n~~~
    BUILDING ~~~\n\nYou start with a Town Hall, which can train Workers.\n\nWorkers
    can construct Farms and Barracks, and gather wood.\n\n\n\n~~~ RESOURCES ~~~\n\nTrees
    \u2192 Each tree contains 150 wood.\nA Worker can carry up to 50 wood at a time.\n\nFarm
    \u2192 Produces 5 gold every 2 seconds.\n\n\n\n~~~ OBJECTIVE ~~~\n\nDestroy the
    enemy Town Hall."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
